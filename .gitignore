# 走查截图验证产物，不进仓库
走查截图/
# Playwright MCP 快照与截图产物
.playwright-mcp/
.playwright-cli/
# v2 本地构建依赖；发布产物不依赖 node_modules
node_modules/
dist/
dist/windows-installer/
installer/winforms/bin/
installer/winforms/obj/
# 构建期生成的内嵌 payload 压缩包（由 build-windows-installer.mjs 产出与清理）
installer/winforms/payload.zip
output/
# landing 构建缓存与导出目录（发布内容由 .deploy/ 承接）
landing/node_modules/
landing/.next/
landing/out/
landing/tsconfig.tsbuildinfo
# .deploy/ 是 EdgeOne Pages Git 部署的发布目录，需要进仓库（wrangler 也读它）
# 但桥二进制（>50MB）不进 git：EdgeOne 超其 25MiB 单文件限制，且安装包走 GitHub Release 附件
.edgeone-deploy/
.deploy/livedot-bridge-win-x64.exe
.deploy/livedot-bridge-win-x64.blob
.deploy/windows-installer/livedot-bridge-win-x64.exe
.deploy/windows-installer/livedot-bridge-win-x64.blob
# 安装器本体 ~196MB 超 GitHub 100MB 单文件硬限，永远不进 git（走 GitHub Release 附件）；
# 通道 update-manifest.json 发布时不带 installer 字段，桥端回退本地 exe 执行切换。
.deploy/windows-installer/LiveDotMapSetup.exe
# 任何误放进仓库的密钥/环境文件都不进 git（真凭证存仓库外 ~/.live-dot-map/）
*.env
*.secrets
*.credentials

# 平台登录/控制台截图与抓取快照，不进入源码或发布物料
edgeone-config.yml
edgeone-login.png

# 活点地图项目数据目录（单一事实源，避免多 worktree 物理复制分叉与合并冲突）
/.live-dot-map/
.live-dot-map/

# 工位隔离测试实例的运行时状态目录（npm run dev 自动生成）
.live-dot-map-dev/

# zcode 客户端在项目根写入的运行时目录（测试残留，不入库）
.zcode/

# 软件著作权申请材料与本地 LaTeX 编译环境（含营业执照等隐私信息）
.tools/

# 本地临时日志、排查压缩包与临时目录
logs/
tmp/
*.zip
.codex-remote-attachments/
tools/cnipa-word-xml/
_共享资产*/
